{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "projectName",
            "type": "promptString",
            "description": "输入 Bazel 项目名称",
            "default": "highly-toxic-water"
        }
    ],
    "tasks": [
        {
            "label": "Bazel Build",
            "type": "shell",
            "command": "bazel",
            "args": [
                "build",
                "//subprojects/${input:projectName}:${input:projectName}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Bazel Run Server",
            "type": "shell",
            "command": "bazel",
            "args": [
                "run",
                "//subprojects/${input:projectName}:server"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Bazel Publish",
            "type": "shell",
            "command": "bazel",
            "args": [
                "run",
                "//subprojects/${input:projectName}:publish"
            ],
            "detail": "仅适用于 BUILD.bazel 中声明了 modrinth_project_id 的子项目",
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
