load("@//rule:merge_json.bzl", "merge_json")
load("@//rule:publish.bzl", "publish", "publish_entry")
load("@//rule:version.bzl", "minecraft_versions_range")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")

pack_version = "2.2.0"

pack_name = "Localization-Resource-Pack"

game_versions = minecraft_versions_range("1.13")

git_tag_name = "%s_v%s" % (pack_name, pack_version)

# 合并assets和translate目录中的JSON文件
merge_json(
    name = "merged_translations",
    srcs = glob(
        ["assets/**/*.json"],
        allow_empty = True,
    ) + [
        "//:translate_files",
    ],
)

pkg_files(
    name = "localization_resource_pack_assets",
    srcs = [":merged_translations"],
    strip_prefix = "",
)

# 直接产出带版本号的文件名：它同时是 Modrinth 文件名/版本名与 GitHub Release 附件名
pkg_zip(
    name = pack_name,
    srcs = [
        ":README.md",
        ":localization_resource_pack_assets",
        ":pack.mcmeta",
        ":pack.png",
    ],
    out = "release/%s_v%s.zip" % (pack_name, pack_version),
)

publish_entry(
    name = "publish_entry",
    file = ":" + pack_name,
    game_versions = game_versions,
)

publish(
    name = "publish",
    changelog = "NEWS.md",
    entries = [":publish_entry"],
    git_tag_name = git_tag_name,
    loaders = ["minecraft"],
    project_id = "3S0b1XES",
    token_secret_id = "modrinth_token",
    version_id = pack_version,
    version_type = "release",
)
